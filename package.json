{
  "name": "sambad",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/postgres/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=backend/prisma/postgres/schema.prisma",
    "prisma:dbpush": "npx prisma db push --schema=backend/prisma/postgres/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=backend/prisma/postgres/schema.prisma"
  },
  "devDependencies": {
    "@types/parallax-js": "^3.1.3",
    "concurrently": "^9.2.3"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.28.0",
    "multer": "^2.2.0",
    "parallax-js": "^3.1.0",
    "pg": "^8.22.0",
    "react-redux": "^9.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
